---
import CityList from '~/components/worshippers/CityList.astro'
import CityMap from '~/components/worshippers/CityMap.astro'
---

<section
  data-name='CitiesMap'
  class='mx-auto mb-12 max-w-6xl px-4'
>
  <h2 class='text-eia-500 mb-8 text-2xl font-bold'>Adoradores por Provincia</h2>

  <div class='bg-ritual-800 rounded-lg p-6'>
    <div class='grid gap-8 md:grid-cols-2'>
      <CityList />
      <CityMap />
    </div>
  </div>
</section>
