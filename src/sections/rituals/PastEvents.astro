---
import PastEvent from '~/components/rituals/PastEvent.astro'
import type { Image } from '~/types'

interface Event {
  assistants: number | string
  date: string | Date
  description: string
  eventType: string
  image: Image
  place: string
  title: string
}

const EVENTS = [
  {
    title: 'Take Me Back to Eden',
    eventType: 'Listening Party',
    place: 'Buenos Aires',
    date: 'Diciembre 2024',
    description:
      'Una noche mágica donde 80 adoradores se reunieron para celebrar el álbum anterior.',
    assistants: 80,
    image: {
      alt: 'Take Me Back to Eden Listening Party',
      src: '/images/albums/TMBTE.webp',
      width: 800,
      height: 600,
    },
  }
] satisfies Event[]

---

<section
  data-name='PastEvents'
  class='mx-auto mb-12 max-w-6xl px-4'
>
  <h2 class='text-eia-500 mb-8 text-2xl font-bold'>Rituales Pasados</h2>

  <div class='grid gap-6 md:grid-cols-2'>
    {EVENTS.map(({ title, place, date, description, assistants, image }) => (
      <PastEvent
        title={title}
        eventType={place}
        place={place}
        date={date}
        description={description}
        assistants={assistants}
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
      />
    ))}
  </div>
</section>
