---
import Arrow from '~/assets/arrow.svg'
import type { Image } from '~/types'

interface Props {
  assistants: number | string
  date: string | Date
  description: string
  eventType: string
  src: Image['src']
  alt: Image['alt']
  width: Image['width']
  height: Image['height']
  place: string
  title: string
}

const {
  assistants,
  date,
  description,
  eventType,
  width,
  place,
  title,
  height,
  src,
  alt
} = Astro.props
---

<article class='bg-ritual-800 overflow-hidden rounded-lg'>
  <div class='h-48'>
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      class='h-full w-full object-cover'
    />
  </div>
  <div class='p-6'>
    <h3 class='text-eia-300 mb-2 text-lg font-semibold'>
      {title} - {eventType}
    </h3>
    <p class='mb-3 text-sm text-gray-400'>{place} • {date}</p>
    <p class='mb-4 text-gray-300'>
      {description}
    </p>
    <div class='flex items-center justify-between'>
      <span class='text-sm text-gray-400'>👥 {assistants} asistentes</span>
      <button class='text-eia-500 hover:text-eia-300 transition-colors flex items-center gap-2'>
        Ver fotos <Arrow class='size-4' />
      </button>
    </div>
  </div>
</article>
