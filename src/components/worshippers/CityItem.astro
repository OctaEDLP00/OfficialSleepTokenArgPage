---
interface Props {
  province: string
  worshippersCount: number
}

const { province, worshippersCount } = Astro.props
---

<a
  href='javascript:void(0)'
  class='bg-ritual-700 flex items-center justify-between rounded-lg p-4'
>
  <div class='flex items-center space-x-3'>
    <span class='text-eia-500'>📍</span>
    <div>
      <div class='font-semibold text-white'>{province}</div>
    </div>
  </div>
  <div class='text-eia-500 font-bold'>{worshippersCount}</div>
</a>
